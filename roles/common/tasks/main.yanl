- name: Copy mongo repo
    ansible.builtin.copy:
      src: mongo.repo
      dest: /etc/yum.repos.d/mongo.repo
  
  - name: install mongodb 
    ansible.builtin.dnf:
      name: mongodb-org
      state: present

  - name: start and enable mongod
    ansible.builtin.service:
      name: mongod
      state: started
      enabled: yes

  - name: mongodb port open
    ansible.builtin.replace:
      path: /etc/mongod.conf
      regexp: '127.0.0.1'
      replace: '0.0.0.0'
  
  - name: Restart mongod 
    ansible.builtin.service:
      name: mongod
      state: restarted